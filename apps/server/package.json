{
	"name": "@sekai/server",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun --watch run src/index.ts",
		"start": "bun run src/index.ts",
		"build": "bun build src/index.ts --compile --minify --sourcemap --outfile dist/sekai-server",
		"typecheck": "tsc --noEmit -p .",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"test:discord": "bun run scripts/discord-e2e.ts",
		"test:proxmox": "bun run scripts/proxmox-e2e.ts",
		"reset-password": "bun run scripts/reset-password.ts"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^2.7.0",
		"@anthropic-ai/claude-agent-sdk": "^0.3.325",
		"@discordjs/voice": "^0.19.2",
		"@modelcontextprotocol/sdk": "^1.32.2",
		"@msgpack/msgpack": "^3.1.3",
		"@sekai/shared": "workspace:*",
		"@simplewebauthn/server": "^14.1.0",
		"@snazzah/davey": "^0.2.0",
		"croner": "^11.0.0",
		"cronstrue": "^3.39.0",
		"discord.js": "^14.28.1",
		"drizzle-orm": "^0.45.4",
		"emusks": "2.3.20",
		"fflate": "^0.8.3",
		"hono": "^4.13.18",
		"jose": "^6.2.17",
		"nodemailer": "^10.6.0",
		"opusscript": "^0.1.1",
		"playwright-core": "1.65.1",
		"postgres": "^3.4.9",
		"prism-media": "^1.3.5",
		"qrcode": "^1.5.4",
		"unpdf": "^2.2.1",
		"web-push": "^4.0.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/nodemailer": "^8.0.2",
		"@types/qrcode": "^1.5.6",
		"drizzle-kit": "^0.31.11"
	}
}
