{
	"name": "Sekai",
	"short_name": "Sekai",
	"description": "Your team of AI agents",
	"id": "/",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["window-controls-overlay", "standalone"],
	"orientation": "any",
	"background_color": "#ffffff",
	"theme_color": "#ffffff",
	"icons": [
		{
			"src": "/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		}
	],
	"launch_handler": {
		"client_mode": ["navigate-existing", "auto"]
	},
	"categories": ["productivity", "utilities"],
	"shortcuts": [
		{
			"name": "Needs you",
