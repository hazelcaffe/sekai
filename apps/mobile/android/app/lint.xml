<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- The splash icon is the launcher foreground drawn bigger, so some densities match byte for byte. -->
    <issue id="IconDuplicates">
        <ignore path="src/main/res/drawable-*/splash_icon.png" />
        <ignore path="src/main/res/mipmap-*/ic_launcher_foreground.png" />
    </issue>
    <!-- Held back on purpose: the later releases need compileSdk 37 (see gradle/libs.versions.toml). -->
    <issue id="GradleDependency">
        <ignore regexp="compose-bom|activity|lifecycle" />
    </issue>
</lint>
