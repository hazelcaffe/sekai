<?xml version="1.0" encoding="utf-8"?>
<!--
    Plain http is allowed: people reach Sekai on their own network or over Tailscale. Certificates people installed
    themselves are trusted too (a home server with its own certificate authority), as in a browser.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <base-config
        cleartextTrafficPermitted="true"
        tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
            <certificates
                src="user"
                tools:ignore="AcceptsUserCertificates" />
        </trust-anchors>
    </base-config>
</network-security-config>
