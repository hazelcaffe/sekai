<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The screens are Compose (Material 3, see ui/Theme.kt); this is the window behind them. -->
    <style name="Theme.Sekai" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>

    <style name="Theme.Sekai.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Sekai</item>
    </style>
</resources>
