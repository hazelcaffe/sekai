# Models: any OpenAI-compatible endpoint (a gateway such as LiteLLM, OpenRouter, a local Ollama…). You can also set
# it, and add Anthropic-, Gemini- or OpenAI-compatible API providers, in Admin → Models.
GATEWAY_URL=
GATEWAY_API_KEY=

# Postgres (docker compose up -d db --wait). The app container overrides this to use the "db" service.
DATABASE_URL=postgres://sekai:sekai@127.0.0.1:5433/sekai
# POSTGRES_USER=sekai
# POSTGRES_PASSWORD=sekai
# POSTGRES_DB=sekai
# POSTGRES_PORT=5433

# API server
SEKAI_HOST=127.0.0.1
SEKAI_PORT=7420
# Host interface Docker publishes the app on (keep 127.0.0.1 behind a reverse proxy; 0.0.0.0 to reach it on your LAN).
# SEKAI_BIND=127.0.0.1
# Where uploads live (default: ./data at the repo root).
# SEKAI_DATA_DIR=

# On the internet: the address people use (sign-in callbacks, invite and password reset links).
# SEKAI_PUBLIC_URL=https://sekai.example.com
# Proxies whose X-Forwarded-For is believed, besides this machine (comma-separated addresses or ranges).
# SEKAI_TRUST_PROXY=10.0.0.0/8
# Other sites allowed to call the API with a token (comma-separated origins). Cookies never work cross-site.
# SEKAI_CORS_ORIGINS=

# A token for scripts that acts as the first admin (Authorization: Bearer <token>). Optional.
# SEKAI_AUTH_TOKEN=
